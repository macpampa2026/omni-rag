# Copiá este archivo a .env y ajustá lo que necesites.
# Todas las variables usan el prefijo OMNIRAG_

# --- Ollama (motor local de embeddings + generación) ---
OMNIRAG_OLLAMA_URL=http://localhost:11434
OMNIRAG_EMBED_MODEL=nomic-embed-text
OMNIRAG_GEN_MODEL=qwen2.5:7b

# --- Parámetros de RAG ---
OMNIRAG_CHUNK_CHARS=1000
OMNIRAG_CHUNK_OVERLAP=150
OMNIRAG_TOP_K=8
OMNIRAG_GEN_TEMPERATURE=0.1
OMNIRAG_GEN_NUM_PREDICT=500
# Reranking opcional (reordena un pool de candidatos con el LLM antes del top-k):
OMNIRAG_RERANK_ENABLED=false
OMNIRAG_RERANK_CANDIDATES=20

# --- Almacenamiento ---
# Índice JSON local (se usa si NO hay DATABASE_URL):
OMNIRAG_INDEX_PATH=data/index.json

# --- Base de datos (M2): si la definís, usa PostgreSQL + pgvector ---
# Cadena de conexión de Neon (ejemplo). Notar el driver `+psycopg`:
# OMNIRAG_DATABASE_URL=postgresql+psycopg://usuario:password@ep-xxxx.neon.tech/neondb?sslmode=require
OMNIRAG_DATABASE_URL=
OMNIRAG_EMBED_DIM=768

# --- Cache opcional (M4): Redis para cachear embeddings de consultas ---
# OMNIRAG_REDIS_URL=redis://localhost:6379/0
OMNIRAG_REDIS_URL=

# --- API ---
# Si definís una clave, todos los endpoints (excepto /health) la exigen en el header X-API-Key.
OMNIRAG_API_KEY=
OMNIRAG_LOG_LEVEL=INFO
